---
import Button from './gb/Button.astro';
import IconButton from './gb/IconButton.astro';

const repo = 'https://github.com/google/elephant-goldfish-model';
const guide = `${repo}/blob/HEAD/docs/getting_started.md`;

const paths = [
  { label: 'Ask your agent', text: `Install ${repo}`, copyLabel: 'Copy prompt', kind: 'prompt' },
  { label: 'Antigravity CLI', text: `agy plugin install ${repo}`, copyLabel: 'Copy Antigravity command', kind: 'cli' },
  { label: 'Claude Code', text: `claude plugin marketplace add google/elephant-goldfish-model\nclaude plugin install egm@egm`, copyLabel: 'Copy Claude Code command', kind: 'cli' },
  { label: 'Codex', text: `codex plugin marketplace add google/elephant-goldfish-model\ncodex plugin add egm@egm`, copyLabel: 'Copy Codex command', kind: 'cli' },
];
---

<section class="section install" id="install">
  <div class="wrap">
    <div class="section-head">
      <h2 class="headline">Install the plugin.</h2>
      <p class="lead">
        Built for <a href="https://antigravity.google" target="_blank" rel="noopener">Antigravity</a>,{' '}
        <a href="https://code.claude.com" target="_blank" rel="noopener">Claude Code</a>,{' '}
        <a href="https://claude.ai/plugins" target="_blank" rel="noopener">Claude Cowork</a>, and{' '}
        <a href="https://openai.com/codex" target="_blank" rel="noopener">Codex</a>.
      </p>
    </div>

    <div class="paths">
      {
        paths.map((path) => (
          <div class="path">
            <p class="path-label">{path.label}</p>
            <div class:list={['copybox', path.kind === 'prompt' ? 'copybox-prompt' : 'copybox-cli']}>
              {path.kind === 'prompt' ? (
                <span class="prompt-text">{path.text}</span>
              ) : (
                <code class="command">{path.text}</code>
              )}
              <IconButton label={path.copyLabel} color="tonal" size="sm" data-copy={path.text}>
                <svg class="icon-copy" viewBox="0 -960 960 960" aria-hidden="true">
                  <path
                    d="M360-240q-33 0-56.5-23.5T280-320v-480q0-33 23.5-56.5T360-880h360q33 0 56.5 23.5T800-800v480q0 33-23.5 56.5T720-240H360Zm0-80h360v-480H360v480ZM200-80q-33 0-56.5-23.5T120-160v-560h80v560h440v80H200Zm160-240v-480 480Z"
                  ></path>
                </svg>
                <svg class="icon-check" viewBox="0 -960 960 960" aria-hidden="true">
                  <path d="M382-240 154-468l57-57 171 171 367-367 57 57-424 424Z"></path>
                </svg>
              </IconButton>
            </div>
          </div>
        ))
      }
    </div>

    <Button color="outlined" size="md" href={guide} target="_blank">Read the setup guide</Button>
  </div>
</section>

<script>
  // Clipboard copy for the install command and prompt. This is the only script on the page.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const label = button.getAttribute('aria-label') ?? '';
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
      } catch {
        return; // No clipboard permission; the command is still selectable text.
      }
      button.classList.add('copied');
      button.setAttribute('aria-label', 'Copied');
      setTimeout(() => {
        button.classList.remove('copied');
        button.setAttribute('aria-label', label);
      }, 1600);
    });
  }
</script>

<style>
  .install {
    padding-block: var(--section-y-tight) var(--section-y);
  }

  .paths {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    max-inline-size: 760px;
    margin-block-end: clamp(32px, 5vw, 48px);
  }

  .path-label {
    margin: 0 0 8px;
    font: var(--md-sys-typescale-label-lg);
    color: var(--md-sys-color-on-surface-variant);
  }

  .copybox {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 8px 8px 20px;
    border: 1px solid var(--md-sys-color-outline-variant);
  }

  .copybox-prompt {
    border-radius: 999px;
    background: var(--md-sys-color-surface);
    border-color: var(--md-sys-color-outline);
  }

  .copybox-cli {
    border-radius: var(--md-sys-shape-corner-md);
    background: var(--md-sys-color-surface-container-low);
  }

  .prompt-text {
    flex: 1;
    min-inline-size: 0;
    font: var(--md-sys-typescale-body-md);
    overflow-x: auto;
    white-space: nowrap;
    user-select: all;
  }

  .command {
    flex: 1;
    min-inline-size: 0;
    padding-block: 4px;
    font-size: 0.9375rem;
    line-height: 1.55;
    overflow-x: auto;
    white-space: pre;
    user-select: all;
  }

  .icon-check,
  :global(.copied) .icon-copy {
    display: none;
  }

  :global(.copied) .icon-check {
    display: block;
  }

</style>
