---
const steps = [
  {
    name: 'Brainstorm',
    command: '/egm-brainstorm',
    body: 'Clarify the problem and run a six-lens goldfish swarm to produce a stress-tested concept brief.',
  },
  {
    name: 'Draft',
    command: '/egm-draft',
    body: 'Turn the brief into a living design doc under docs/designs/, section by section.',
  },
  {
    name: 'Review',
    command: '/egm-review',
    body: 'A fresh, zero-context session checks completeness, clarity, self-containment, and readiness before implementation starts.',
  },
];
---

<section class="section loop">
  <div class="wrap">
    <div class="section-head">
      <h2 class="headline">From idea to spec to code</h2>
    </div>
    <ol class="steps">
      {
        steps.map((step, i) => (
          <li class="step">
            <span class="badge badge-large">{i + 1}</span>
            <h3 class="title">{step.name}</h3>
            <span class="cmd">{step.command}</span>
            <p class="muted">{step.body}</p>
          </li>
        ))
      }
      <li class="step">
        <span class="badge badge-large" aria-hidden="true">
          <svg viewBox="0 -960 960 960">
            <path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z"></path>
          </svg>
        </span>
        <h3 class="title">Build</h3>
        <p class="muted">
          The spec is complete enough to hand directly to your LLM to execute.
        </p>
      </li>
      <li class="step drift">
        <div class="drift-head">
          <h3 class="title">Weekly</h3>
          <span class="cmd">/egm-drift-report</span>
        </div>
        <p class="muted">
          Flags where the codebase and spec have diverged so you can update whichever changed.
        </p>
      </li>
    </ol>
  </div>
</section>

<style>
  .loop {
    background: var(--md-sys-color-surface-container-low);
  }

  /* One continuous rule carries the sequence; each step's number sits on the line. */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    row-gap: 48px;
  }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-block-start: 32px;
    padding-inline-end: 24px;
    border-block-start: 1px solid var(--md-sys-color-outline-variant);
  }

  .step:nth-child(4n) {
    padding-inline-end: 0;
  }

  /* Badge theming through its documented custom properties. The outline in the band
     color lifts the number off the rule. */
  .step :global(.badge) {
    --container-color: var(--md-sys-color-primary);
    --label-text-color: var(--md-sys-color-on-primary);
    --label-text: var(--md-sys-typescale-label-lg);
    --size: 28px;
    position: absolute;
    inset-block-start: -14px;
    inset-inline-start: 0;
    outline: 6px solid var(--md-sys-color-surface-container-low);
  }

  .step:nth-child(1) :global(.badge),
  .step:nth-child(2) :global(.badge) {
    --container-color: var(--md-sys-color-secondary);
    --label-text-color: var(--md-sys-color-on-secondary);
  }

  .step:nth-child(3) :global(.badge) {
    --container-color: var(--md-sys-color-error);
    --label-text-color: var(--md-sys-color-on-error);
  }

  .step :global(.badge) > svg {
    inline-size: 16px;
    block-size: 16px;
    fill: currentColor;
  }

  .cmd {
    line-height: 1.5rem;
    color: var(--md-sys-color-on-surface);
    background: var(--md-sys-color-surface-container-high);
    border-radius: 6px;
    padding: 2px 8px;
    inline-size: fit-content;
  }

  /* Step 4 has no command chip; reserve the chip height + gap so its paragraph aligns with steps 1-3. */
  .step:nth-child(4) .muted {
    margin-block-start: calc(1.5rem + 4px + 10px);
  }

  /* The weekly check is not a fifth step: same anatomy, laid across the whole rule. */
  .drift {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    column-gap: 0;
    align-items: start;
    padding-inline-end: 0;
  }

  /* Same column arithmetic as the steps, so the description starts under step two. */
  .drift-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-inline-end: 24px;
  }

  .drift .muted {
    max-inline-size: 60ch;
    padding-block-start: 2px;
  }

  @media (max-width: 1000px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .step:nth-child(4n) {
      padding-inline-end: 24px;
    }

    .step:nth-child(2n) {
      padding-inline-end: 0;
    }

    .drift {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .steps {
      grid-template-columns: 1fr;
      row-gap: 40px;
    }

    .step,
    .step:nth-child(2n),
    .step:nth-child(4n) {
      padding-inline-end: 0;
    }

    .step:nth-child(4) .muted {
      margin-block-start: 0;
    }

    .drift {
      grid-template-columns: 1fr;
      row-gap: 10px;
    }
  }
</style>
