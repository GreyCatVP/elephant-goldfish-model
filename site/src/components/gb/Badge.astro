---
/**
 * gBreeze badge (BADGE_CLASSES in @material/web/labs/gb/components/badge/badge.js).
 * Always rendered in the large form because it carries a label.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const classes = ['badge', 'badge-large', className].filter(Boolean).join(' ');
---

<span class={classes}>
  <slot />
</span>
