---
/**
 * gBreeze list item, native-element form (LIST_ITEM_CLASSES in
 * @material/web/labs/gb/components/list/list.js). The DOM mirrors the render
 * template of <md-gb-list-item>: leading, content (overline, headline,
 * supporting text), trailing (trailing text, trailing icon).
 *
 * With `href` the row is an interactive link (ripple + focus ring); without it
 * the row is static.
 */
interface Props {
  href?: string;
  target?: '_blank' | '_self';
  class?: string;
}

const { href, target, class: className } = Astro.props;
const interactive = Boolean(href);
const classes = [
  interactive && 'ripple',
  interactive && 'focus-ring-outer',
  'list-item',
  !interactive && 'list-item-static',
  className,
]
  .filter(Boolean)
  .join(' ');
const Row = interactive ? 'a' : 'div';
const rel = target === '_blank' ? 'noopener' : undefined;
const slots = Astro.slots;
---

<li>
  <Row class={classes} href={href} target={target} rel={rel}>
    {
      slots.has('leading') && (
        <span class="list-item-leading">
          <slot name="leading" />
        </span>
      )
    }
    <span class="list-item-content">
      {
        slots.has('overline') && (
          <span class="list-item-overline">
            <slot name="overline" />
          </span>
        )
      }
      <slot />
      {
        slots.has('supporting-text') && (
          <span class="list-item-supporting-text">
            <slot name="supporting-text" />
          </span>
        )
      }
    </span>
    {
      (slots.has('trailing-text') || slots.has('trailing')) && (
        <span class="list-item-trailing">
          {
            slots.has('trailing-text') && (
              <span class="list-item-trailing-text">
                <slot name="trailing-text" />
              </span>
            )
          }
          <slot name="trailing" />
        </span>
      )
    }
  </Row>
</li>

<style>
  a.list-item {
    text-decoration: none;
  }
</style>
