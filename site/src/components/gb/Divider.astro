---
/** gBreeze divider (DIVIDER_CLASSES in @material/web/labs/gb/components/divider/divider.js). */
interface Props {
  vertical?: boolean;
  class?: string;
}

const { vertical = false, class: className } = Astro.props;
const classes = ['divider', vertical && 'divider-vertical', className].filter(Boolean).join(' ');
---

<hr class={classes} />
