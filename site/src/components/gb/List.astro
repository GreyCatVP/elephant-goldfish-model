---
/**
 * gBreeze list container (LIST_CLASSES in @material/web/labs/gb/components/list/list.js).
 * Children are <ListItem> rows wrapped in <li>, matching the package usage example.
 */
interface Props {
  segmented?: boolean;
  class?: string;
  label?: string;
}

const { segmented = false, class: className, label } = Astro.props;
const classes = ['list', segmented && 'list-segmented', className].filter(Boolean).join(' ');
---

<ul class={classes} aria-label={label}>
  <slot />
</ul>
