---
import Button from './gb/Button.astro';

const essay =
  'https://medium.com/@drensin/elephants-goldfish-and-the-new-golden-age-of-software-engineering-c33641a48874';
---

<section class="section-tight essay" id="essay">
  <div class="wrap">
    <div class="essay-grid">
      <h2 class="headline">Origin of the model</h2>
      <div class="essay-body">
        <p class="lead">
          Dave Rensin&rsquo;s essay &ldquo;Elephants, Goldfish, and the New Golden Age of Software
          Engineering&rdquo; introduces the core premise that deep context helps when drafting a
          design and hurts when reviewing it.
        </p>
        <Button color="outlined" size="md" href={essay} target="_blank">
          Read the essay on Medium
          <svg viewBox="0 -960 960 960" aria-hidden="true">
            <path d="m216-160-56-56 464-464H360v-80h400v400h-80v-264L216-160Z"></path>
          </svg>
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .essay {
    /* Tight below so Essay → Install matches the Skills → Essay gap above. */
    padding-block: 0 var(--section-y-tight);
  }

  .essay-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px clamp(32px, 6vw, 96px);
    align-items: start;
    padding-block-start: clamp(40px, 6vw, 64px);
  }

  .essay-grid .headline {
    margin-block: 0;
  }

  .essay-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  @media (max-width: 820px) {
    .essay-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
