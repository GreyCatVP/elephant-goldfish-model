---
import Divider from './gb/Divider.astro';

const repo = 'https://github.com/google/elephant-goldfish-model';

const groups = [
  {
    label: 'Project',
    links: [
      { label: 'GitHub', href: repo },
      { label: 'Getting started', href: `${repo}/blob/HEAD/docs/getting_started.md` },
      { label: 'Contributing', href: `${repo}/blob/HEAD/CONTRIBUTING.md` },
    ],
  },
  {
    label: 'Related',
    links: [
      { label: 'Antigravity', href: 'https://antigravity.google' },
      { label: 'Antigravity CLI', href: 'https://antigravity.google/product/antigravity-cli' },
      { label: 'Agent Development Kit', href: 'https://adk.dev' },
      { label: 'A2A Protocol', href: 'https://a2a-protocol.org' },
    ],
  },
  {
    label: 'Google',
    links: [
      { label: 'Privacy', href: 'https://policies.google.com/privacy' },
      { label: 'Terms', href: 'https://policies.google.com/terms' },
    ],
  },
];
---

<footer class="footer scheme-dark">
  <div class="wrap">
    <Divider />
    <div class="links">
      {
        groups.map((group) => (
          <nav aria-label={group.label}>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <p class="legal muted">
      <svg class="g" viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
        ></path>
        <path
          d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
        ></path>
        <path
          d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"
        ></path>
        <path
          d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"
        ></path>
      </svg>
      {/* One span so the sentence stays one flex item; spaces stay on one line (compressHTML). */}
      <span>
        Copyright 2026 Google LLC. Licensed under the <a href={`${repo}/blob/HEAD/LICENSE`} target="_blank" rel="noopener">Apache License, Version 2.0</a>. This is not an officially supported Google product.
      </span>
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 0 48px;
  }

  .footer :global(.divider) {
    --color: var(--md-sys-color-outline-variant);
  }

  /* One footer: a row of links, then the legal line. Groups keep their nav labels for
     assistive tech; visually they are one list with a wider gap between groups. */
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    padding-block: 40px 24px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
  }

  li a {
    text-decoration: none;
    color: var(--md-sys-color-on-surface-variant);
  }

  li a:hover {
    color: var(--md-sys-color-on-surface);
    text-decoration: underline;
  }

  .legal {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font: var(--md-sys-typescale-label-md);
    letter-spacing: 0;
  }

  /* The G sits on the first line of the legal text and takes its color. */
  .g {
    flex: none;
    inline-size: 16px;
    block-size: 16px;
    fill: currentColor;
  }
</style>
