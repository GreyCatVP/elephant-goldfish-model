---
// Copyright 2026 Google LLC. SPDX-License-Identifier: Apache-2.0
const chart = 'https://api.star-history.com/svg?repos=google/elephant-goldfish-model&type=Date';
const history = 'https://www.star-history.com/#google/elephant-goldfish-model&Date';
---

<section class="section" id="star-history" aria-labelledby="star-history-title">
  <div class="wrap">
    <div class="section-head">
      <h2 class="headline" id="star-history-title">Star history</h2>
      <p class="muted">GitHub stars over time.</p>
    </div>
    <figure>
      <a href={history} target="_blank" rel="noopener noreferrer">
        <picture>
          <source media="(prefers-color-scheme: dark)" srcset={`${chart}&theme=dark`} />
          <img
            src={chart}
            alt="GitHub star history for google/elephant-goldfish-model"
            width="800"
            height="533"
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
          />
        </picture>
      </a>
      <figcaption class="muted">
        Chart provided by <a href={history} target="_blank" rel="noopener noreferrer">Star History</a>.{' '}
        <a href="https://github.com/google/elephant-goldfish-model/stargazers">View stargazers on GitHub</a>.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  figure {
    margin: 0;
    max-inline-size: 800px;
  }

  img {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  figcaption {
    margin-block-start: 16px;
    font: var(--md-sys-typescale-body-sm);
  }
</style>
