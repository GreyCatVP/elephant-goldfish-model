---
import Button from './gb/Button.astro';
---

<section class="hero" id="top">
  <div class="wrap hero-inner">
    <h1 class="display">
      Design with an elephant.<br />
      Review with a goldfish.
    </h1>
    <p class="lead">
      <span class="nowrap">Spec-driven</span> development with AI coding agents, <span class="nowrap">open-sourced</span> by Google and used by thousands of Google engineers every month.{' '}
      <span class="nowrap">Deep-context</span> agents draft the design. <span class="nowrap">Zero-context</span> agents tear it apart before any code is written. You own the outcome.
    </p>
    <div class="cta">
      <Button color="filled" size="md" href="#install">Get started</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(80px, 12vw, 160px) clamp(48px, 7vw, 96px);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
  }

  .lead {
    max-inline-size: 62ch;
  }

  .cta {
    margin-block-start: 8px;
  }
</style>
