---
import Button from './gb/Button.astro';
---

<section class="hero" id="top">
  <div class="wrap hero-inner">
    <h1 class="display">
      Design with an elephant.<br />
      Review with a goldfish.
    </h1>
    <p class="lead">
      {/* Explicit spaces: compressHTML drops newline whitespace next to elements. */}
      <span class="nowrap">Spec-driven</span> development with AI coding agents.<br class="wide" />{' '}
      <span class="nowrap">Deep-context</span> agents draft the design. <span class="nowrap">Zero-context</span> agents tear it apart<br class="wide" />{' '}
      before any code is written. You own the outcome.
    </p>
    <div class="cta">
      <Button color="filled" size="md" href="#install">Get started</Button>
    </div>
    <p class="meta muted">
      An open-source project by Google &middot; Used by thousands of Google engineers every month
    </p>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(80px, 12vw, 160px) clamp(48px, 7vw, 96px);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
  }

  .lead {
    max-inline-size: 58ch;
  }

  /* Authored breaks once the lead is at full width: first sentence alone, then a clause break.
     Below that the browser wraps; the nowrap spans keep the hyphenated words whole. */
  .wide {
    display: none;
  }

  @media (min-width: 720px) {
    .wide {
      display: inline;
    }
  }

  .cta {
    margin-block-start: 8px;
  }

  .meta {
    font: var(--md-sys-typescale-label-lg);
  }
</style>
