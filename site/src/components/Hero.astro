---
import Button from './gb/Button.astro';
---

<section class="hero" id="top">
  <div class="wrap hero-inner">
    <h1 class="display">
      Design with an elephant.<br />
      Review with a goldfish.
    </h1>
    <p class="lead">
      Spec-driven development with AI coding agents. Deep-context agents draft the design.
      Zero-context agents tear it apart before any code is written. You own the outcome.
    </p>
    <div class="cta">
      <Button color="filled" size="md" href="#install">Get started</Button>
    </div>
    <p class="meta muted">
      An open-source project by Google &middot; Used by thousands of Google engineers every month &middot; Apache&nbsp;2.0
    </p>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(80px, 12vw, 160px) clamp(48px, 7vw, 96px);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
  }

  .lead {
    max-inline-size: 58ch;
    /* Balanced so the last line is not a two-word widow; pretty only guards single words. */
    text-wrap: balance;
  }

  .cta {
    margin-block-start: 8px;
  }

  .meta {
    font: var(--md-sys-typescale-label-lg);
  }
</style>
