---
import SkillIcon from './SkillIcon.astro';

const repo = 'https://github.com/google/elephant-goldfish-model';

// User-facing slash-command entry points from the repository Skills Catalog.
const skills = [
  {
    name: 'Brainstorm',
    command: '/egm-brainstorm',
    dir: 'egm_brainstorm',
    icon: 'brainstorm',
    body: 'Test an idea and write a concept brief.',
  },
  {
    name: 'Draft',
    command: '/egm-draft',
    dir: 'egm_draft',
    icon: 'draft',
    body: 'Turn a brief or existing notes into a design document.',
  },
  {
    name: 'Review',
    command: '/egm-review',
    dir: 'egm_review',
    icon: 'review',
    body: 'Review a design with fresh agents across five stages.',
  },
  {
    name: 'Resolve',
    command: '/egm-resolve',
    dir: 'egm_resolve',
    icon: 'resolve',
    body: 'Work through review findings and agree on changes.',
  },
  {
    name: 'Drift Report',
    command: '/egm-drift-report',
    dir: 'egm_drift_report',
    icon: 'drift_report',
    body: 'Compare checked-in documents with the current source code.',
  },
  {
    name: 'Bootstrap',
    command: '/egm-bootstrap',
    dir: 'egm_bootstrap',
    icon: 'bootstrap',
    body: 'Create or update documentation for an existing codebase.',
  },
  {
    name: 'Review loop',
    command: '/egm-review-loop',
    dir: 'egm_review_loop',
    icon: 'review_loop',
    body: 'Run a configured group of reviewers for a specific review task.',
  },
] as const;
---

<section class="section skills" id="skills">
  <div class="wrap">
    <div class="section-head">
      <h2 class="headline">Included skills</h2>
    </div>
    <ul class="list" aria-label="Skills">
      {
        skills.map((skill) => (
          <li>
            <a
              class="ripple focus-ring-outer list-item"
              href={`${repo}/blob/main/skills/${skill.dir}/SKILL.md`}
              target="_blank"
              rel="noopener"
            >
              <span class="list-item-leading">
                <SkillIcon skill={skill.icon} />
              </span>
              <span class="list-item-content">
                <span class="skill-heading">
                  <span>{skill.name}</span>
                  <span class="cmd">{skill.command}</span>
                </span>
                <span class="list-item-supporting-text">{skill.body}</span>
              </span>
              <span class="list-item-trailing">
                <svg viewBox="0 -960 960 960" aria-hidden="true">
                  <path d="m216-160-56-56 464-464H360v-80h400v400h-80v-264L216-160Z" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Each row groups the title, command, and description beside its skill icon. */
  .skills .list {
    border-radius: 0;
    border-block-start: 1px solid var(--md-sys-color-outline-variant);
  }

  .skills .list > li {
    border-block-end: 1px solid var(--md-sys-color-outline-variant);
  }

  .skills .list-item {
    text-decoration: none;
    --container-shape: var(--md-sys-shape-corner-md);
    --label-text: var(--md-sys-typescale-title-lg);
    --top-space: 22px;
    --bottom-space: 24px;
    --leading-space: 8px;
    --trailing-space: 8px;
    --between-space: 24px;
    --trailing-icon-size: 22px;
    align-items: center;
    /* The package rounds a list's first and last rows by inheriting the list's own corners.
       With the straight hairline above (list radius 0) that left the end rows half-square on
       hover; every row's state layer now follows its own shape token on all four corners. */
    border-radius: var(--container-shape);
  }

  .skills .list-item-leading {
    display: flex;
    align-items: center;
    flex: none;
    inline-size: 40px;
    min-height: 0;
  }

  .skills .list-item-content {
    min-inline-size: 0;
  }

  .skill-heading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 12px;
  }

  .skills .list-item-trailing {
    align-self: center;
  }

  .skills .list-item-supporting-text {
    max-inline-size: 56ch;
    margin-block-start: 2px;
    text-wrap: balance;
  }

  .cmd {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--md-sys-color-on-surface-variant);
  }

  @media (max-width: 760px) {
    .skills .list-item {
      --between-space: 16px;
      --top-space: 18px;
      --bottom-space: 20px;
    }
  }
</style>
