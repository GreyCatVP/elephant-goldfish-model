---
import List from './gb/List.astro';
import ListItem from './gb/ListItem.astro';

const repo = 'https://github.com/google/elephant-goldfish-model';

// Mirrors "The Skills Catalog" table in the repository README. Commands are verbatim.
const skills = [
  {
    name: 'Brainstorm',
    command: '/egm-brainstorm',
    dir: 'egm_brainstorm',
    body: 'Ideate before any document exists. A six-lens goldfish swarm stress-tests the raw concept and returns a brief.',
  },
  {
    name: 'Draft',
    command: '/egm-draft',
    dir: 'egm_draft',
    body: 'Compile a markdown design specification section by section, with the elephant holding the full context.',
  },
  {
    name: 'Review',
    command: '/egm-review',
    dir: 'egm_review',
    body: 'Run the multi-stage verification pipeline: zoom out, comprehension, critic, readiness.',
  },
  {
    name: 'Review Loop',
    command: 'egm_review_loop',
    dir: 'egm_review_loop',
    body: 'Dispatch concurrent review subagents, directly or hierarchically. The engine behind Review.',
  },
  {
    name: 'Review Resolve',
    command: '/egm-resolve',
    dir: 'egm_resolve',
    body: 'Triage review findings interactively and apply the agreed patches to the specification.',
  },
  {
    name: 'Drift Report',
    command: '/egm-drift-report',
    dir: 'egm_drift_report',
    body: 'Scan the syntax tree and flag where the live code and the checked-in spec have diverged.',
  },
  {
    name: 'Bootstrap',
    command: '/egm-bootstrap',
    dir: 'egm_bootstrap',
    body: 'Generate bottom-up documentation for an existing codebase and keep it current in sentinel blocks.',
  },
];
---

<section class="section skills" id="skills">
  <div class="wrap">
    <div class="section-head">
      <h2 class="headline">Seven skills. Plain markdown.</h2>
      <p class="lead">
        Each skill is a folder with a SKILL.md that your agent reads. No runtime, no SDK,
        no <span class="nowrap">lock-in</span>. Open one to see exactly what the agent is told to do.
      </p>
    </div>
    <List label="Skills">
      {
        skills.map((skill) => (
          <ListItem href={`${repo}/tree/HEAD/skills/${skill.dir}`} target="_blank">
            <code slot="leading" class="cmd">
              {skill.command}
            </code>
            {skill.name}
            <Fragment slot="supporting-text">{skill.body}</Fragment>
            <svg slot="trailing" viewBox="0 -960 960 960" aria-hidden="true">
              <path d="m216-160-56-56 464-464H360v-80h400v400h-80v-264L216-160Z" />
            </svg>
          </ListItem>
        ))
      }
    </List>
  </div>
</section>

<style>
  /* An index, not a stack of cards: hairline rows, the command in its own column so the
     seven commands read as one aligned list, name and description beside it. List item
     theming goes through the component's documented custom properties. */
  .skills :global(.list) {
    border-radius: 0;
    border-block-start: 1px solid var(--md-sys-color-outline-variant);
  }

  .skills :global(.list > li) {
    border-block-end: 1px solid var(--md-sys-color-outline-variant);
  }

  .skills :global(.list-item) {
    --container-color: transparent;
    --container-shape: var(--md-sys-shape-corner-md);
    --label-text: var(--md-sys-typescale-title-lg);
    --supporting-text: var(--md-sys-typescale-body-md);
    --top-space: 22px;
    --bottom-space: 24px;
    --leading-space: 8px;
    --trailing-space: 8px;
    --between-space: 24px;
    --trailing-icon-size: 22px;
    --trailing-icon-color: var(--md-sys-color-on-surface-variant);
    align-items: baseline;
    /* The package rounds a list's first and last rows by inheriting the list's own corners.
       With the straight hairline above (list radius 0) that left the end rows half-square on
       hover; every row's state layer now follows its own shape token on all four corners. */
    border-radius: var(--container-shape);
  }

  .skills :global(.list-item-leading) {
    flex: none;
    inline-size: 15rem;
    min-height: 0;
  }

  .skills :global(.list-item-trailing) {
    align-self: center;
  }

  .skills :global(.list-item-supporting-text) {
    max-inline-size: 60ch;
    margin-block-start: 2px;
  }

  .cmd {
    font-size: 0.8125rem;
    color: var(--md-sys-color-on-surface-variant);
  }

  @media (max-width: 760px) {
    .skills :global(.list-item) {
      flex-wrap: wrap;
      --between-space: 16px;
      --top-space: 18px;
      --bottom-space: 20px;
    }

    .skills :global(.list-item-leading) {
      inline-size: 100%;
      line-height: 1.25rem;
      margin-block-end: -6px;
    }

    .skills :global(.list-item-content) {
      flex-basis: 0;
    }
  }
</style>
