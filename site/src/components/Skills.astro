---
import List from './gb/List.astro';
import ListItem from './gb/ListItem.astro';

const repo = 'https://github.com/google/elephant-goldfish-model';

// User-facing slash-command entry points from the repository Skills Catalog.
const skills = [
  {
    name: 'Brainstorm',
    command: '/egm-brainstorm',
    dir: 'egm_brainstorm',
    body: 'Stress-test a raw concept across six adversarial lenses to produce an initial concept brief.',
  },
  {
    name: 'Draft',
    command: '/egm-draft',
    dir: 'egm_draft',
    body: 'Compile a markdown design spec section by section while the elephant holds the full system context.',
  },
  {
    name: 'Review',
    command: '/egm-review',
    dir: 'egm_review',
    body: 'Run the multi-stage verification pipeline: zoom out, comprehension, critic, readiness.',
  },
  {
    name: 'Bootstrap',
    command: '/egm-bootstrap',
    dir: 'egm_bootstrap',
    body: 'Generate bottom-up documentation for an existing codebase and keep it current in sentinel blocks.',
  },
  {
    name: 'Drift Report',
    command: '/egm-drift-report',
    dir: 'egm_drift_report',
    body: 'Scan the syntax tree and flag where the live code and the checked-in spec have diverged.',
  },
];
---

<section class="section skills" id="skills">
  <div class="wrap">
    <div class="section-head">
      <h2 class="headline">Skills</h2>
    </div>
    <List label="Skills">
      {
        skills.map((skill) => (
          <ListItem href={`${repo}/tree/HEAD/skills/${skill.dir}`} target="_blank">
            <code slot="leading" class="cmd">
              {skill.command}
            </code>
            {skill.name}
            <Fragment slot="supporting-text">{skill.body}</Fragment>
            <svg slot="trailing" viewBox="0 -960 960 960" aria-hidden="true">
              <path d="m216-160-56-56 464-464H360v-80h400v400h-80v-264L216-160Z" />
            </svg>
          </ListItem>
        ))
      }
    </List>
  </div>
</section>

<style>
  /* An index, not a stack of cards: hairline rows, the command in its own column so the
     five commands read as one aligned list, name and description beside it. List item
     theming goes through the component's documented custom properties. */
  .skills :global(.list) {
    border-radius: 0;
    border-block-start: 1px solid var(--md-sys-color-outline-variant);
  }

  .skills :global(.list > li) {
    border-block-end: 1px solid var(--md-sys-color-outline-variant);
  }

  .skills :global(.list-item) {
    --container-color: transparent;
    --container-shape: 0;
    --label-text: var(--md-sys-typescale-title-lg);
    --supporting-text: var(--md-sys-typescale-body-md);
    --top-space: 22px;
    --bottom-space: 24px;
    --leading-space: 8px;
    --trailing-space: 8px;
    --between-space: 24px;
    --trailing-icon-size: 22px;
    --trailing-icon-color: var(--md-sys-color-on-surface-variant);
    align-items: baseline;
  }

  .skills :global(.list-item-leading) {
    flex: none;
    inline-size: 15rem;
    min-height: 0;
  }

  .skills :global(.list-item-trailing) {
    align-self: center;
  }

  .skills :global(.list-item-supporting-text) {
    max-inline-size: 60ch;
    margin-block-start: 2px;
  }

  .cmd {
    font-size: 1rem;
    color: var(--md-sys-color-on-surface);
  }

  @media (max-width: 760px) {
    .skills :global(.list-item) {
      flex-wrap: wrap;
      --between-space: 16px;
      --top-space: 18px;
      --bottom-space: 20px;
    }

    .skills :global(.list-item-leading) {
      inline-size: 100%;
      line-height: 1.25rem;
      margin-block-end: -6px;
    }

    .skills :global(.list-item-content) {
      flex-basis: 0;
    }
  }
</style>
